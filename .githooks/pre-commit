#!/usr/bin/env python3
"""Check formatting of staged first-party sources without changing the index."""

import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys


def git(*args):
    return subprocess.check_output(["git", *args])


def main():
    root = Path(os.fsdecode(git("rev-parse", "--show-toplevel")).strip())
    os.chdir(root)
    paths = git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").split(b"\0")
    failed = False
    missing = set()
    for raw_path in filter(None, paths):
        path = os.fsdecode(raw_path)
        if path.startswith(("deps/", "subprojects/")):
            continue
        # Symlinks and submodules are not source blobs to format.
        mode = git("ls-files", "--stage", "-z", "--", path).split(b" ", 1)[0]
        if mode not in (b"100644", b"100755"):
            continue
        source = git("show", ":" + path)
        suffix = Path(path).suffix.lower()
        if suffix in {".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx", ".m", ".mm"}:
            command = ["clang-format", "--style=file", "--assume-filename=" + str(root / path)]
            fix = ["clang-format", "-i", "--", path]
        elif suffix == ".py" or (
            source.startswith(b"#!") and b"python" in source.split(b"\n", 1)[0]
        ):
            command = ["black", "--quiet", "--stdin-filename", path, "-"]
            fix = ["black", "--", path]
        else:
            continue
        formatter = command[0]
        if not shutil.which(formatter):
            missing.add(formatter)
            failed = True
            continue
        result = subprocess.run(command, input=source, stdout=subprocess.PIPE)
        if result.returncode:
            failed = True
        elif result.stdout != source:
            print(f"Formatting required: {path}\n  {shlex.join(fix)}", file=sys.stderr)
            failed = True
    if missing:
        print("Install the required formatters: " + ", ".join(sorted(missing)), file=sys.stderr)
    if failed:
        print("Format the files, review and stage the changes, then commit again.", file=sys.stderr)
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
